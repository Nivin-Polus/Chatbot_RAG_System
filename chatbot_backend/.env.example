# --- AI Provider Configuration ---
# Options: claude, bedrock
AI_PROVIDER=claude

# --- Claude Configuration ---
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.0
# SYSTEM_PROMPT=

# --- AWS Bedrock Configuration ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MODEL=anthropic.claude-3-5-sonnet-20241022-v1:0

# --- Server Configuration ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
APP_MODE=api
DEBUG=False
# RELOAD=False

# --- Frontend Integration ---
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_URL=https://dev-chatbot.polussolutions.com/chatbot
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database Configuration ---
# Types: mysql, postgresql, sqlite
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=chatbot_rag
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password
DATABASE_CHARSET=utf8mb4
DATABASE_COLLATION=utf8mb4_unicode_ci

# Connection Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# SSL Settings
DATABASE_SSL_DISABLED=false
# DATABASE_SSL_CA=
# DATABASE_SSL_CERT=
# DATABASE_SSL_KEY=

# --- Vector Database (Qdrant) ---
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_FALLBACK=true

# --- Redis Cache (Optional) ---
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=5

# --- Security & Authentication ---
# CRITICAL: Generate a strong random key for production
SECRET_KEY=your-super-secret-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PLUGIN_TOKEN_EXPIRE_DAYS=30

# API Credentials (for basic auth or internal tools)
API_USERNAME=your_username
API_PASSWORD_HASH=your_hashed_password

# --- File & Uploads ---
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,docx,pptx,xlsx,txt,csv
UPLOAD_DIR=uploads

# --- RAG Tuning ---
RAG_MIN_SCORE=0.25
RAG_LEADERSHIP_MIN_SCORE=0.15
SOURCE_MIN_SCORE=0.15
MAX_CONTEXT_TOKENS=4000

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
MAX_CONCURRENT_REQUESTS=20

# --- Logging ---
ACTIVITY_LOG_DIR=activity_logs
ACTIVITY_RETENTION_DAYS=30

# --- Plugins & Widgets ---
CHAT_WIDGET_HOST_URL=
PLUGIN_EMBED_BASE_URL=https://keyword-search.mit.edu/dist/
